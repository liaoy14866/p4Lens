{
  "name": "p4lens",
  "displayName": "P4Lens",
  "publisher": "liaoy14866",
  "description": "Display P4 blame information inline in VS Code, similar to GitLens",
  "icon": "images/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/liaoy14866/p4Lens.git"
  },
  "version": "0.1.1",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:p4config.txt"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": []
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npx @vscode/vsce package",
    "publish": "npx @vscode/vsce publish",
    "publish:patch": "npx @vscode/vsce publish patch"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.1.0",
    "@types/vscode": "^1.60.0",
    "@types/node": "^14.0.0",
    "typescript": "^4.0.0"
  }
}
