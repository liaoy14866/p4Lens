{
  "name": "p4lenslite",
  "displayName": "P4LensLite",
  "publisher": "liaoy14866",
  "description": "Display P4 blame information inline in VS Code, similar to GitLens",
  "icon": "images/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/liaoy14866/p4Lens.git"
  },
  "version": "0.1.5",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:p4config.txt"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "p4lenslite.checkOpenStateCache",
        "title": "Check P4 Cache Staleness",
        "category": "P4LensLite"
      },
      {
        "command": "p4lenslite.copyChangelistNumber",
        "title": "Copy Changelist Number",
        "category": "P4LensLite"
      }
    ],
    "configuration": {
      "title": "P4LensLite",
      "properties": {
        "p4LensLite.openStatePollIntervalSeconds": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "markdownDescription": "Interval in seconds for automatic P4 cache staleness checks based on `p4 opened`. Default is `10`. Set to `0` to disable automatic polling. You can still run **P4LensLite: Check P4 Cache Staleness** manually from the Command Palette."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npx @vscode/vsce package",
    "publish": "npx @vscode/vsce publish",
    "publish:patch": "npx @vscode/vsce publish patch"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.1.0",
    "@types/vscode": "^1.60.0",
    "@types/node": "^14.0.0",
    "typescript": "^4.0.0"
  }
}
